---
import { Code } from 'astro:components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resources, readResource } from '../../lib/repository';
export function getStaticPaths() { return resources.map(resource => ({ params: { slug: resource.slug }, props: { resource } })); }
interface Props { resource: (typeof resources)[number]; }
const { resource } = Astro.props;
const source = readResource(resource.path);
---
<BaseLayout title={resource.title}><main id="main" class="container standard-page source-page"><div class="breadcrumb"><a href="/learn/">学习手册</a><span>/</span><span>源文件</span></div><h1 class="page-title">{resource.title}</h1><p class="page-intro">对照项目中保存的代码与材料，核对每个结论的出处。</p><div class="source-toolbar"><span class="mono">{resource.path}</span><a class="button" href={`/raw/${resource.slug}.txt`} download={resource.path.split('/').at(-1)}>下载原文件 ↓</a></div><div class="prose"><Code code={source} lang={resource.language} wrap={false} /></div><a class="text-link" href="/learn/">← 返回学习手册</a></main></BaseLayout>
